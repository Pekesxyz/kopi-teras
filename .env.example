# Koneksi MySQL (format: mysql://USER:PASSWORD@HOST:PORT/DATABASE)
DATABASE_URL="mysql://root:@localhost:3307/kopi_teras"

# Rahasia untuk menandatangani sesi login staf (JWT). WAJIB diganti di produksi.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# URL publik aplikasi yang bisa diakses HP pelanggan (dipakai untuk generator QR Code meja).
# Contoh di jaringan lokal kafe: http://192.168.1.10:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Path gambar QRIS Statis (letakkan file di folder /public).
NEXT_PUBLIC_QRIS_IMAGE="/qrcodes/qris-kopi-teras.svg"

# Folder penyimpanan file unggahan (bukti bayar & gambar menu). Default: ./storage/uploads
# UPLOAD_DIR="D:/kopi-teras-uploads"
